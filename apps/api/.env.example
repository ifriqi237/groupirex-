# GROUPDEALS — configuration de l'API. Copier en .env et compléter.

NODE_ENV=development            # development | test | staging | production
PORT=4000
PUBLIC_URL=http://localhost:4000 # URL publique du site (https obligatoire en production)
TRUST_PROXY=false               # true derrière un répartiteur de charge (lit X-Forwarded-For)
CORS_ORIGINS=                   # origines autorisées, séparées par des virgules (inutile si le site est servi par l'API)

# Base de données PostgreSQL. Ajouter ?sslmode=require pour chiffrer la connexion.
DATABASE_URL=postgres://groupdeals:groupdeals@localhost:5432/groupdeals
DATABASE_POOL_SIZE=10
# DATABASE_CA_FILE=/chemin/ca.pem   # vérifie le certificat du serveur
# DATABASE_DRIVER=pg                # utilise le paquet npm "pg" au lieu du client intégré

# Secrets — OBLIGATOIRES en staging et en production.
JWT_SECRET=                     # openssl rand -base64 48
ENCRYPTION_KEY=                 # openssl rand -hex 32   (chiffre les secrets de double authentification)
REQUIRE_STAFF_2FA=false         # true par défaut en production : 2FA obligatoire pour le personnel

# Paiement en ligne. "sandbox" simule le prestataire (interdit en production).
PAYMENT_PROVIDER=sandbox        # sandbox | flutterwave
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=       # le « secret hash » saisi dans le tableau de bord Flutterwave

# Emails (OBLIGATOIRE en production) : vérification de l'adresse, mot de passe oublié, notifications.
# Exemple messagerie Hostinger : SMTP_HOST=smtp.hostinger.com, SMTP_PORT=465, l'adresse et son mot de passe.
SMTP_HOST=
SMTP_PORT=465                   # 465 (chiffré) ou 587 (STARTTLS)
SMTP_SECURITY=                  # ssl | starttls (déduit du port si vide)
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=                      # ex. GROUPDEALS <no-reply@votre-domaine.com>

DEFAULT_COUNTRY=CM              # pays montré aux visiteurs non connectés
UPLOADS_DIR=./uploads           # médias envoyés par l'administration
RUN_JOBS=true                   # tâches de fond (expiration des commandes, envois)
LOG_LEVEL=info                  # silent | info | debug
