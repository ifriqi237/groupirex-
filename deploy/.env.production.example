# GROUPDEALS — configuration de PRODUCTION (copier en deploy/.env, ne jamais publier ce fichier).

# Domaine du site, sans https:// (ses DNS doivent pointer vers le serveur).
DOMAIN=groupdeals.com
PUBLIC_URL=https://groupdeals.com

# Mot de passe de la base (long et aléatoire : openssl rand -base64 32).
POSTGRES_PASSWORD=

# Secrets de l'application (OBLIGATOIRES).
JWT_SECRET=                      # openssl rand -base64 48
ENCRYPTION_KEY=                  # openssl rand -hex 32  — à conserver précieusement
REQUIRE_STAFF_2FA=true

# Paiement en ligne (Flutterwave, mode test d'abord, puis clés réelles).
PAYMENT_PROVIDER=flutterwave
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# Emails (OBLIGATOIRE) — par exemple la messagerie de votre hébergeur.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-reply@groupdeals.com
SMTP_PASSWORD=
MAIL_FROM=GROUPDEALS <no-reply@groupdeals.com>

DEFAULT_COUNTRY=CM
BACKUP_KEEP_DAYS=14
